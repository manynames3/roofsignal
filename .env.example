# Future server-side AI integration placeholders.
# Do not expose production AI provider keys through VITE_* variables.

# VITE_VISION_PROVIDER=openai
# VITE_VISION_ENABLED=false

# Optional free NREL PVWatts integration for preliminary solar production estimates.
# Register for a free key at https://developer.nrel.gov/signup/
# Keep production integrations server-side before handling real customer volume.
# VITE_NREL_API_KEY=replace-with-free-nrel-key

# Server-only examples for a future backend:
# VISION_PROVIDER=openai
# VISION_API_KEY=replace-with-server-side-secret
# NREL_API_KEY=replace-with-server-side-nrel-key
