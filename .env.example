# Future server-side AI integration placeholders.
# Do not expose production AI provider keys through VITE_* variables.

# VITE_VISION_PROVIDER=openai
# VITE_VISION_ENABLED=false

# Optional local-only NREL PVWatts integration for preliminary solar production estimates.
# In hosted mode, use the AWS /solar-estimate Lambda proxy instead of exposing this key.
# VITE_NREL_API_KEY=replace-with-free-nrel-key

# Optional AWS hosted backend. These values come from `terraform -chdir=infra/aws output`.
# VITE_AWS_API_URL=https://replace.execute-api.us-east-1.amazonaws.com
# VITE_AWS_REGION=us-east-1
# VITE_AWS_USER_POOL_ID=us-east-1_replace
# VITE_AWS_USER_POOL_CLIENT_ID=replace
# VITE_AWS_COGNITO_DOMAIN=https://replace.auth.us-east-1.amazoncognito.com

# Optional server-side Gemini integration for photo evidence tag suggestions.
# Do not create VITE_GEMINI_API_KEY.
# Hosted AWS mode stores the Gemini key in SSM and calls the AWS Lambda endpoint.
# The Cloudflare Pages Function secret is optional for local/unauthenticated demo mode only.
# GEMINI_API_KEY=replace-with-server-side-gemini-key
# GOOGLE_GENERATIVE_AI_API_KEY=alternate-server-side-gemini-key-name
# GEMINI_MODEL=gemini-2.5-flash-lite

# Server-only AWS secrets are stored by Terraform in SSM SecureString parameters:
# GEMINI_API_KEY
# NREL_API_KEY
